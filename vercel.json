{
  "headers": [
    {
      "source": "/demo",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://floressspace.vercel.app http://localhost:3000" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://floressspace.vercel.app http://localhost:3000" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
